# Base44 Superagent credentials for the Celeste chat widget.
# Set these in Netlify: Site configuration > Environment variables, then redeploy.

# Required. Personal API key (or personal access token) for a user with access to the
# Celeste agent. Copy it from the Celeste agent editor, Developer / API Docs panel.
# Workspace API keys are rejected by these endpoints.
BASE44_API_KEY=replace_with_personal_api_key

# Optional. Defaults to the Celeste agent endpoint below, so you normally leave this unset.
BASE44_BASE_URL=https://app.base44.com/api/agents/6a512bd87e7e4c489690fbb6
